{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the main window may do. Least privilege: the app's own commands, listening to app events, the folder picker and frontend logging. Moving, minimizing, maximizing and closing its own window (it draws its title bar). No file system, shell or opener access: paths are resolved in Rust from task ids.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-decorated",
    "core:window:allow-is-maximized",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "dialog:allow-open",
    "log:allow-log",
    "allow-list-tasks",
    "allow-add-task",
    "allow-pause-task",
    "allow-resume-task",
    "allow-cancel-task",
    "allow-remove-task",
    "allow-pause-all",
    "allow-resume-all",
    "allow-move-task",
    "allow-select-files",
    "allow-get-settings",
    "allow-set-settings",
    "allow-subscribe-progress",
    "allow-default-download-dir",
    "allow-reveal-task",
    "allow-get-task-detail",
    "allow-inspect-torrent",
    "allow-take-external-requests",
    "allow-list-offers",
    "allow-accept-offer",
    "allow-decline-offer",
    "allow-bridge-status",
    "allow-new-bridge-token",
    "allow-release-notes",
    "allow-app-version",
    "allow-check-for-update",
    "allow-install-update",
    "allow-diagnostics-report",
    "allow-save-diagnostics",
    "allow-open-logs-folder"
  ]
}
